{
  "name": "dsh-token-panel",
  "version": "1.0.0",
  "description": "DSH 侧边栏 Token 用量面板：点击侧边栏底部「使用统计」按钮弹出统计面板——按天/按小时趋势图、模型用量仪表盘、活跃热力图，支持今天/昨天/最近7·30天/本月/上月/自定义区间。",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run-acceptance.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "token",
    "usage",
    "statistics",
    "sidebar",
    "panel",
    "使用统计"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonZhang528/dsh-token-panel.git"
  },
  "homepage": "https://github.com/JasonZhang528/dsh-token-panel#readme",
  "bugs": {
    "url": "https://github.com/JasonZhang528/dsh-token-panel/issues"
  },
  "author": "JasonZhang528",
  "engines": {
    "node": ">=20"
  }
}
