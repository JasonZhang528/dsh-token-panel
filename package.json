{
  "name": "dsh-token-panel",
  "version": "0.1.1",
  "description": "DSH 侧边栏 Token 用量统计：原生菜单 + 主区域页面，含用量趋势、模型刻度环、GitHub 风格活跃热力图、会话与供应商统计（分页）、自动刷新，支持深浅双主题。",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "scripts": {
    "test": "node tests/run-acceptance.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "token",
    "usage",
    "statistics",
    "sidebar",
    "panel",
    "用量统计"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonZhang528/dsh-token-panel.git"
  },
  "homepage": "https://github.com/JasonZhang528/dsh-token-panel#readme",
  "bugs": {
    "url": "https://github.com/JasonZhang528/dsh-token-panel/issues"
  },
  "author": "JasonZhang528",
  "engines": {
    "node": ">=20"
  }
}
